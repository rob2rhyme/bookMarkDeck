rules_version = '2';

// Firestore security rules for Bookmark Deck.
//
// All user data lives under users/{uid}: the user document (bookmarks[],
// folders[], shortcuts[], …), its subcollections (bookmarkBackups), and every
// feature pillar — focus*, habit*, inventory*, filing* and notes* collections alike.
//
// Owner-scoped rules cover the user document and everything beneath it —
// current and future. That is why adding a pillar needs no rule change: a new
// collection under users/{uid} is already covered. The one content check is
// lockedTextSealed() below: encrypted fields of locked notes and papers. Only the
// owner's Google account (verified email, allowedEmails() below) gets in at all,
// and only to its own uid; everything else is denied by default.
//
// Verified against the Firestore emulator (80 assertions — the count is printed
// by scripts/verify-firestore-rules.mjs and repeated in CLAUDE.md, so the three
// move together): the owner can reach
// every pillar's collections including deeply nested paths, a second signed-in
// uid is denied read, write and delete on all of them, unauthenticated access
// is denied, any other account (or an unverified or missing email) is denied
// even its own users/{uid}, a locked note or paper carrying plaintext is
// refused even from the owner, and nothing outside users/{uid} matches any
// allow statement.

service cloud.firestore {
  match /databases/{database}/documents {

    // Bookmark Deck has one owner. Must match DEFAULT_ALLOWED_EMAILS in
    // src/auth/allowlist.ts — src/auth/allowlist.test.ts fails if they differ.
    // Without this, anyone could sign into Firebase with the public web config
    // and keep data (at the owner's cost) under their own users/{uid}.
    function allowedEmails() {
      return ['rob2rhyme@gmail.com', 'noah18thapa@gmail.com'];
    }

    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in allowedEmails();
    }

    // A locked note's body and a locked paper's reference and note are end-to-end
    // encrypted; the plaintext must never reach the server. The client already
    // refuses to send it (notesData toFirestore, filingData documentPayload) —
    // this holds the same line if a client ever doesn't. Both writers replace the
    // whole document, so request.resource.data is exactly what was sent. An empty
    // string is not plaintext (a locked paper can carry reference: "").
    function lockedTextSealed(collection) {
      let d = request.resource.data;
      return d.get('lock', null) == null
        || (collection == 'notes' && d.get('body', '') == '')
        || (collection == 'filingDocuments'
            && d.get('reference', '') in [null, '']
            && d.get('note', '') in [null, ''])
        || !(collection in ['notes', 'filingDocuments']);
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{collection}/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && lockedTextSealed(collection);
      }

      // Anything nested deeper (users/{uid}/a/b/c/d…). {sub} keeps this from
      // also matching a top-level document, which would OR past the check above.
      match /{collection}/{docId}/{sub}/{rest=**} {
        allow read, write: if isOwner(uid);
      }
    }

  }
}
