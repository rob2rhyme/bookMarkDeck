{
  "name": "bookmarkdeck",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "lint:eslint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "verify:rules": "node scripts/verify-firestore-rules.mjs",
    "verify:rules:emulated": "npx -y firebase-tools@15.28.2 emulators:exec --only firestore --project rules-check \"npm run verify:rules\"",
    "check:rules": "node scripts/check-deployed-rules.mjs",
    "check:sa": "node scripts/check-service-account.mjs",
    "deploy:rules": "npx -y firebase-tools@15.28.2 deploy --only firestore:rules --non-interactive"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@upstash/qstash": "^2.12.0",
    "@upstash/redis": "^1.39.0",
    "barcode-detector": "^3.2.2",
    "express": "^5.3.0",
    "firebase": "^12.19.0",
    "next": "^16.4.0",
    "next-auth": "^4.24.14",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "^7.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "~8.4.3",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "minimatch": ">=10.2.1",
    "protobufjs": ">=7.6.3 <8",
    "@grpc/grpc-js": ">=1.9.16 <2",
    "qs": ">=6.16.0",
    "path-to-regexp": ">=8.4.0",
    "postcss": ">=8.5.23 <9",
    "@xmldom/xmldom": ">=0.9.12"
  }
}
