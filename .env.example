# NextAuth configuration
NEXTAUTH_URL=https://your-domain.example.com
NEXTAUTH_SECRET=replace-with-generated-secret

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional. Who may sign in, comma-separated. Unset = the owner only (the
# default in src/auth/allowlist.ts) — leaving it unset never opens sign-in up.
# AUTH_ALLOWED_EMAILS=you@example.com

# Public Google OAuth client id for the client-side Google Drive sync path
# (src/utils/googleDriveSync.ts, scope drive.appdata). Safe to expose; can be the
# same OAuth client as GOOGLE_CLIENT_ID above. Drive sync no-ops without it.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Firebase (client config — read in src/lib/firebase.ts)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Web Push (focus timer-end alerts) — optional; push is a no-op without these.
# Generate VAPID keys: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Upstash QStash (schedules the timer-end push) — from console.upstash.com/qstash
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# My Stuff barcode → product lookup AND price comparison (optional). Defaults to
# the UPCitemdb *trial* endpoint (no key, rate-limited, thin store offers). To
# use a paid tier — richer, real-time competitor prices in the price-comparison
# panel — point the URL at the paid endpoint and set the key (no code change).
# Without a key, price comparison falls back to the store links you save per item.
UPC_LOOKUP_URL=
UPC_LOOKUP_KEY=

# My Stuff AI capture (optional) — snap a photo, Claude vision names the
# product (name/brand/category/rough price) so you can wishlist it or add it as
# an item. Off (with a friendly in-app notice) until the key is set. Get a key
# at console.anthropic.com. Costs are pay-per-use: about a tenth of a cent per scan
# on the default model (claude-haiku-5-5, the cheapest vision tier); set
# AI_CAPTURE_MODEL to a bigger model (e.g. claude-opus-5-5, roughly
# 1–3 cents a scan) for max accuracy.
ANTHROPIC_API_KEY=
AI_CAPTURE_MODEL=

# My Stuff photo storage on Cloudflare R2 (optional). Set ALL five to move item
# photos off the Firestore doc and into R2 (uploaded via a session-gated presign
# route → direct browser PUT). Until then, photos stay as compressed data: URLs.
# The same five vars also enable Filing's optional scans (PDFs + images attached
# to a paper); without them that surface simply doesn't appear.
# The bucket needs a CORS rule allowing PUT from your app origin, and public read
# (r2.dev or a custom domain) mapped to R2_PUBLIC_BASE_URL. See README.
# Note the public bucket is a DIFFERENT ORIGIN with no auth in front of it — an
# object URL is unguessable but not access-controlled.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Premium billing (optional) — Lemon Squeezy (merchant-of-record; remits global
# tax) + an Upstash Redis entitlement store. Leave ALL unset to disable the
# paywall entirely: metered features (AI capture/insights) then serve every
# signed-in user as before. When set, non-pro users get a small monthly free
# allowance, then a 402 upgrade prompt. See MONETIZATION-PWA.md.
# - API key + store/variant ids: app.lemonsqueezy.com (Settings → API, Store, Product)
# - Webhook secret: the signing secret you set when creating the LS webhook,
#   pointed at https://your-domain/api/billing/webhook
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Upstash Redis REST creds — from console.upstash.com/redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
