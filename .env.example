# NextAuth configuration
NEXTAUTH_URL=https://your-domain.example.com
NEXTAUTH_SECRET=replace-with-generated-secret

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Firebase (client config — read in src/lib/firebase.ts)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Web Push (focus timer-end alerts) — optional; push is a no-op without these.
# Generate VAPID keys: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Upstash QStash (schedules the timer-end push) — from console.upstash.com/qstash
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# My Stuff barcode → product lookup (optional). Defaults to the UPCitemdb
# *trial* endpoint (no key, rate-limited). To use a paid tier, point the URL at
# the paid endpoint and set the key — no code change needed.
UPC_LOOKUP_URL=
UPC_LOOKUP_KEY=

# My Stuff photo storage on Cloudflare R2 (optional). Set ALL five to move item
# photos off the Firestore doc and into R2 (uploaded via a session-gated presign
# route → direct browser PUT). Until then, photos stay as compressed data: URLs.
# The bucket needs a CORS rule allowing PUT from your app origin, and public read
# (r2.dev or a custom domain) mapped to R2_PUBLIC_BASE_URL. See README.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
