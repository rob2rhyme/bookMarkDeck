# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright
/test-results/
/playwright-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.crt

# Service-account keys. The rules-deploy setup has the owner download a Google
# private key (see .github/workflows/firestore-rules.yml); *.key above doesn't
# cover it, because GCP hands it out as .json. It belongs in the
# FIREBASE_SERVICE_ACCOUNT repo secret and nowhere else — these patterns are the
# backstop for a stray drag into the working tree. Named narrowly so no real
# config file is shadowed.
*-firebase-adminsdk-*.json
service-account*.json
*-service-account.json
serviceaccount*.json
gcp-key*.json
unified-project-*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firebase-debug.log*
firestore-debug.log*
database-debug.log*
ui-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.env.local
/launcher-desktop/node_modules
/launcher-desktop/dist
/launcher-desktop/out
/launcher-desktop/certs

# Capacitor (native iOS shell — generated locally via `npx cap add ios`)
/ios/App/Pods/
/ios/App/App/public/
/ios/App/output/
/ios/.gradle/
